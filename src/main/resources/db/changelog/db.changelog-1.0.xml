<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
		xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
		xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
		xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.0.xsd
        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">


	<changeSet id="001" author="alex">
		<createTable tableName="event">
			<column name="id" type="text"><constraints primaryKey="true" /></column>
			<column name="name" type="text"><constraints nullable="false" /></column>
			<column name="start_date" type="date"><constraints nullable="false" /></column>
			<column name="end_date" type="date"><constraints nullable="false" /></column>
			<column name="website" type="text"><constraints nullable="false" /></column>
			<column name="venue" type="text"><constraints nullable="false" /></column>
		</createTable>
	</changeSet>

</databaseChangeLog>
